model questions {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_id           String               @db.Uuid
  user_id           String?              @default(dbgenerated("auth.uid()")) @db.Uuid
  external_id       String?
  position          Int?
  domain            question_domain?
  skill             String?
  difficulty        question_difficulty?
  passage           String?
  question_text     String
  options           Json                 @default("[]")
  correct_answer    String
  explanation       String?
  has_visual        Boolean              @default(false)
  visual_data       String?
  extraction_status extraction_status    @default(verified)
  created_at        DateTime             @default(now()) @db.Timestamptz(6)
  is_default        Boolean              @default(false)
  visual_url        String?
  /// 'reading_writing' | 'math'. Which SAT section this question belongs to.
  section           String               @default("reading_writing")
  /// 'mcq' (A–D choices) | 'spr' (student-produced free response, math only).
  answer_format     String               @default("mcq")
  /// For SPR questions: the list of accepted answers (numeric-normalized at
  /// ingest). Null for MCQ, whose answer is the single letter in correct_answer.
  accepted_answers  Json?
  /// Whether the question is still live in College Board's Bluebook (true) vs.
  /// disclosed/retired (false). Null when the source didn't provide a status.
  active            Boolean?
  /// Bluebook release key (e.g. '2026-08') the question first appeared in. Null
  /// = original pool. Drives the Question Bank's Original/New switch; the ingest
  /// stamps it only on newly-inserted rows, never reclassifying existing ones.
  release_batch     String?
  answers           answers[]
  attempt_questions attempt_questions[]
  question_banks    question_banks       @relation(fields: [bank_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users?               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bank_id], map: "idx_questions_bank")
  @@index([domain], map: "idx_questions_domain")
  @@index([skill], map: "idx_questions_skill")
  @@index([section, release_batch], map: "idx_questions_release_batch")
  @@schema("public")
}

