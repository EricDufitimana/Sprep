model answers {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Null attempt_id = untimed question-bank practice (no sitting). Non-null =
  // a timed test or module sitting.
  attempt_id      String?        @db.Uuid
  question_id     String         @db.Uuid
  user_id         String         @default(dbgenerated("auth.uid()")) @db.Uuid
  // How the attempt was made: 'test' | 'module' | 'bank'.
  source          String?
  selected_answer String?
  is_correct      Boolean?
