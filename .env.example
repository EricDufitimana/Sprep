# Copy to .env.local and fill in. Never commit real values.

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase ----
# Project Settings -> Data API / API Keys in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Prisma / Postgres ----
# Project Settings -> Database -> Connection string
# DATABASE_URL uses the pooled connection (port 6543, pgbouncer)
# DIRECT_URL uses the direct connection (port 5432) for migrations
DATABASE_URL=
DIRECT_URL=

# ---- Edge function: extract_questions_ai ----
# These are NOT read by the Next.js app. Set them on the function itself:
#   supabase secrets set OPENAI_API_KEY=sk-... OPENAI_MODEL=gpt-4o
# Keeping AI credentials out of the app is deliberate — only the edge function
# ever talks to OpenAI. The model must be vision-capable.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
