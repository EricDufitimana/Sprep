{
  "name": "sprep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-http-header-size=65536 next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && next build",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "node --test --experimental-strip-types \"src/utils/tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "seed:banks": "node --experimental-strip-types --env-file=.env.local scripts/seed-default-banks.mjs",
    "seed:vocab": "node --experimental-strip-types --env-file=.env.local scripts/seed-vocabulary.mjs",
    "seed:sat-vocab": "node --experimental-strip-types --env-file=.env.local scripts/seed-sat-vocab.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@prisma/client": "^6.15.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "@trpc/tanstack-react-query": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "gsap": "^3.13.0",
    "lucide-react": "^0.525.0",
    "mammoth": "^1.12.0",
    "matter-js": "^0.20.0",
    "next": "16.0.7",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20.11.27",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.0.7",
    "postcss": "^8",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "prisma": "^6.15.0",
    "supabase": "^2.40.7",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
